# Copy this file to .env and fill it in. Never share or commit .env.

# Required. Create the key at https://app.gnani.ai/voice
GNANI_API_KEY=

# A language model rewrites the lines, because Prisma and Timbre don't translate.
# Current project setup: use Gemini. The app records the provider actually used.
LLM_PROVIDER=gemini

# Gemini: https://aistudio.google.com. Free-tier inputs can be read by Google's
# reviewers, so use only your own non-personal scripts, or a billed key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional future/alternate provider. This adapter is used only when an Evon endpoint is configured.
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
